{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ManageSageMakerSSHHelperActivations",
      "Effect": "Allow",
      "Action": [
        "ssm:CreateActivation",
        "ssm:AddTagsToResource",
        "ssm:DeregisterManagedInstance",
        "ssm:DescribeInstanceInformation",
        "ssm:ListTagsForResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "PassThisRoleToSSMOnly",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::767397931665:role/sagemaker-competition-notebook-execution-role",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ssm.amazonaws.com"
        }
      }
    },
    {
      "Sid": "ReadSSHAuthorizedKeys",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::sagemaker-us-east-1-767397931665/ssh-authorized-keys/*"
    },
    {
      "Sid": "ListSSHAuthorizedKeys",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::sagemaker-us-east-1-767397931665",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "ssh-authorized-keys",
            "ssh-authorized-keys/*"
          ]
        }
      }
    }
  ]
}
