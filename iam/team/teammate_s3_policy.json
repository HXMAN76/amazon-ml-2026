{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListTeamBucketPrefixes",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::sagemaker-us-east-1-567503593043",
      "Condition": {"StringLike": {"s3:prefix": ["jobs/*", "runs/*", "ber/code_*", "ber/code/*"]}}
    },
    {
      "Sid": "ReadRunsAndCode",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": ["arn:aws:s3:::sagemaker-us-east-1-567503593043/runs/*", "arn:aws:s3:::sagemaker-us-east-1-567503593043/ber/code/*", "arn:aws:s3:::sagemaker-us-east-1-567503593043/jobs/*"]
    },
    {
      "Sid": "SubmitJobsAndPublishOwnRuns",
      "Effect": "Allow",
      "Action": ["s3:PutObject"],
      "Resource": ["arn:aws:s3:::sagemaker-us-east-1-567503593043/jobs/pending/*", "arn:aws:s3:::sagemaker-us-east-1-567503593043/ber/code_*/*"]
    }
  ]
}
