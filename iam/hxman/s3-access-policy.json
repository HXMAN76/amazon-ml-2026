{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "TeamBucketReadWrite",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject", "s3:AbortMultipartUpload"],
      "Resource": ["arn:aws:s3:::ml-challenge-nooglers/*", "arn:aws:s3:::sagemaker-us-east-1-567503593043/*"]
    },
    {
      "Sid": "TeamBucketList",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetBucketLocation", "s3:ListBucketMultipartUploads"],
      "Resource": ["arn:aws:s3:::ml-challenge-nooglers", "arn:aws:s3:::sagemaker-us-east-1-567503593043"]
    },
    {
      "Sid": "SageMakerDefaultBucket",
      "Effect": "Allow",
      "Action": ["s3:CreateBucket", "s3:PutBucketPublicAccessBlock"],
      "Resource": "arn:aws:s3:::sagemaker-us-east-1-567503593043"
    }
  ]
}
