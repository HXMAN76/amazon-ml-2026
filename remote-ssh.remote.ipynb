    "%%writefile ssh_notebook/ssh_notebook.py\n",
    "\n",
    "import time\n",
    "import os\n",
    "\n",
    "import sagemaker_ssh_helper\n",
    "sagemaker_ssh_helper.setup_and_start_ssh()\n",
    "\n",
    "while os.environ.get(\"START_SSH\", \"false\") == \"true\":\n",
    "    time.sleep(10)"
   ]
